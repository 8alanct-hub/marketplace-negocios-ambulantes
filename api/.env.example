# Copia este archivo como ".env" (solo en tu computador; .env NUNCA se sube a GitHub).
# En Render estas mismas variables se ponen en "Environment".

# Supabase → proyecto marketplace_ambulante → botón "Connect" → "Session pooler" → URI.
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.pnwtcmbdcywulywkwwdp:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Una frase larga y secreta para firmar los inicios de sesión (inventa una).
JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta

# Direcciones desde donde se puede usar la API, separadas por coma.
# "null" permite abrir el panel con doble clic (file://) para probar en tu computador.
CORS_ORIGIN=https://8alanct-hub.github.io,http://localhost:5500,http://127.0.0.1:5500,null

PORT=3000
